#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Pass only when the ADSP sensor core delivers real accelerometer samples
# whose magnitude is gravity. One attempt with a hard outer bound: libssc's
# own --timeout starts after the sensor has been found and opened, so a
# missing QMI service would otherwise block before any timer exists.
#
# Environment (for tests): ERHAI_SENSORS_REGISTRY, ERHAI_SENSORS_SSCCLI,
# ERHAI_SENSORS_STATE, ERHAI_SENSORS_BOUND (seconds).
set -eu

registry=${ERHAI_SENSORS_REGISTRY:-/var/lib/erhai/sensors/persist/registry}
ssccli=${ERHAI_SENSORS_SSCCLI:-/usr/lib/erhai/sensors/bin/ssccli}
state=${ERHAI_SENSORS_STATE:-/run/erhai-sensors}
bound=${ERHAI_SENSORS_BOUND:-20}
log=$state/accel-gate.log
result=$state/accel-gate.result

fail() {
	printf 'result=fail\nreason=%s\n' "$1" >"$result"
	printf 'ssc-sample-gate: %s\n' "$1" >&2
	exit 1
}

mkdir -p "$state"
rm -f "$log" "$result" "$state/light-gate.log" "$state/light-gate.result"

# Without the per-unit registry the sensor domain has no accelerometer
# configuration; say so instead of timing out.
[ -d "$registry" ] || fail "no imported sensor registry at $registry"
[ -n "$(ls -A "$registry")" ] || fail "imported sensor registry at $registry is empty"
[ -x "$ssccli" ] || fail "$ssccli is not installed"

status=0
timeout --signal=TERM --kill-after=2s "${bound}s" \
	"$ssccli" --sensor=accelerometer --timeout=5 >"$log" 2>&1 || status=$?

# "Accelerometer sensor measurement: X=%f Y=%f Z=%f m/s²"
summary=$(awk '
	/^Accelerometer sensor measurement: X=/ {
		x = $4; y = $5; z = $6
		sub(/^X=/, "", x); sub(/^Y=/, "", y); sub(/^Z=/, "", z)
		m = sqrt(x * x + y * y + z * z)
		n++
		if (m >= 9.51 && m <= 10.11) good++
		last = sprintf("%.3f,%.3f,%.3f", x, y, z)
	}
	END { printf "samples=%d gravity=%d last=%s\n", n, good, last }
' "$log")
printf '%s exit=%s\n' "$summary" "$status" >>"$log"

samples=$(printf '%s\n' "$summary" | sed -n 's/^samples=\([0-9]*\) .*/\1/p')
gravity=$(printf '%s\n' "$summary" | sed -n 's/.* gravity=\([0-9]*\) .*/\1/p')

[ "$samples" -gt 0 ] || fail "no accelerometer sample within ${bound}s (ssccli exit $status)"
# At least three samples, and most of them at 9.81 +/- 0.3 m/s^2: a unit
# that is being carried still passes, a wrong scale or a stuck axis does not.
[ "$samples" -ge 3 ] && [ $((gravity * 2)) -gt "$samples" ] ||
	fail "samples do not measure gravity ($summary)"

printf 'result=pass\n%s\n' "$summary" >"$result"
printf 'ssc-sample-gate: %s\n' "$summary"

# Light is an on-change sensor: one finite, nonnegative lux reading is
# sufficient to prove data delivery. Darkness (zero lux) is valid; response
# to changing illumination and the desktop brightness curve need hardware
# acceptance. Do not publish an uninitialised light sensor to GNOME.
log=$state/light-gate.log
result=$state/light-gate.result
rm -f "$log" "$result"
status=0
timeout --signal=TERM --kill-after=2s "${bound}s" \
	"$ssccli" --sensor=light --timeout=5 >"$log" 2>&1 || status=$?
[ "$status" -eq 0 ] || fail "light sampling did not close normally (ssccli exit $status)"
if grep -qE 'Unable to |CRITICAL|assertion.*failed' "$log"; then
	fail "light sensor reported a lifecycle error"
fi
summary=$(awk '
	/^Light sensor measurement:/ {
		n++
		if ($4 !~ /^[0-9]+([.][0-9]+)?$/ || $5 != "Lux" || $4 > 200000)
			bad++
		last = $4
	}
	END { printf "samples=%d invalid=%d last=%s\n", n, bad, last }
' "$log")
samples=$(printf '%s\n' "$summary" | sed -n 's/^samples=\([0-9]*\) .*/\1/p')
invalid=$(printf '%s\n' "$summary" | sed -n 's/.* invalid=\([0-9]*\) .*/\1/p')
[ "$samples" -gt 0 ] && [ "$invalid" -eq 0 ] || fail "no valid light data ($summary)"
printf 'result=pass\n%s\n' "$summary" >"$result"
printf 'ssc-light-gate: %s\n' "$summary"
