#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

case "$1" in
remove|purge)
	# A stream delivery selected for this boot has no reader any more.
	rm -rf /run/erhai-sensors-ssc
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
	fi
	udevadm control --reload >/dev/null 2>&1 || true
	;;
esac

# The sleep unit, handled the way dh_installsystemd generates it: masked
# while the package is merely removed, forgotten entirely on purge.
if command -v deb-systemd-helper >/dev/null 2>&1; then
	case "$1" in
	remove)
		deb-systemd-helper mask erhai-sensors-sleep.service >/dev/null 2>&1 || true
		;;
	purge)
		deb-systemd-helper purge erhai-sensors-sleep.service >/dev/null 2>&1 || true
		deb-systemd-helper unmask erhai-sensors-sleep.service >/dev/null 2>&1 || true
		;;
	esac
fi

# The imported registry is this unit's own data; purge is the explicit
# request to drop it.
if [ "$1" = purge ]; then
	rm -rf /var/lib/erhai/sensors
fi

exit 0
