#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

SLEEP_TARGETS='sleep.target suspend.target hibernate.target hybrid-sleep.target'
BT_UNITS='erhai-bt-address-generate.service erhai-bt-address.service'

case "$1" in
remove | purge)
	# Undo the masks this package's postinst put in place. Suspend still does
	# not work on this hardware -- removing the package is a statement that the
	# user wants the distribution's behaviour back, not that the bug is fixed.
	if command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl unmask --quiet $SLEEP_TARGETS || true
		[ -d /run/systemd/system ] && systemctl daemon-reload || true
	fi
	if command -v glib-compile-schemas >/dev/null 2>&1; then
		glib-compile-schemas /usr/share/glib-2.0/schemas || true
	fi
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications || true
	fi
	;;
esac

# The Bluetooth address units, handled the way dh_installsystemd generates it:
# masked while the package is merely removed, so a dependency cannot start a
# unit whose program is gone, and forgotten entirely on purge.
#
# /var/lib/erhai/bt-address is not touched in either case. It is this tablet's
# identity rather than this package's file: devices that paired with it know
# that address, and removing a package should not hand the tablet a new one.
case "$1" in
remove)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		for unit in $BT_UNITS; do
			deb-systemd-helper mask "$unit" >/dev/null 2>&1 || true
		done
	fi
	;;
purge)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		for unit in $BT_UNITS; do
			deb-systemd-helper purge "$unit" >/dev/null 2>&1 || true
			deb-systemd-helper unmask "$unit" >/dev/null 2>&1 || true
		done
	elif command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl disable --quiet $BT_UNITS || true
	fi
	;;
esac

exit 0
