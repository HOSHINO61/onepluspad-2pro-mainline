#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

BT_UNITS='erhai-bt-address-generate.service erhai-bt-address.service'
WIFI_UNITS='erhai-wifi-address-generate.service'

if command -v dpkg-maintscript-helper >/dev/null 2>&1; then
	dpkg-maintscript-helper mv_conffile \
		/etc/systemd/logind.conf.d/90-erhai-stopgap.conf \
		/etc/systemd/logind.conf.d/90-erhai-power.conf \
		0.1.6~ -- "$@"
fi

case "$1" in
remove | purge)
	# Nothing to unmask: this package no longer masks the sleep targets, and
	# a mask it did not put there is not its to take away.
	if command -v glib-compile-schemas >/dev/null 2>&1; then
		glib-compile-schemas /usr/share/glib-2.0/schemas || true
	fi
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications || true
	fi
	;;
esac

# The address units, handled the way dh_installsystemd generates it: masked
# while the package is merely removed, so a dependency cannot start a unit whose
# program is gone, and forgotten entirely on purge.
#
# Neither /var/lib/erhai/bt-address nor /var/lib/erhai/wifi-address is touched
# in either case. They are this tablet's identity rather than this package's
# files: devices that paired with it know the one, and DHCP reservations and
# MAC filters know the other, so removing a package should not hand the tablet
# new ones. The radio goes back to the firmware's address at the next boot
# because the udev rule is gone, which is the distribution's behaviour again.
case "$1" in
remove)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		for unit in $BT_UNITS $WIFI_UNITS; do
			deb-systemd-helper mask "$unit" >/dev/null 2>&1 || true
		done
	fi
	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules >/dev/null 2>&1 || true
	fi
	;;
purge)
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		for unit in $BT_UNITS $WIFI_UNITS; do
			deb-systemd-helper purge "$unit" >/dev/null 2>&1 || true
			deb-systemd-helper unmask "$unit" >/dev/null 2>&1 || true
		done
	elif command -v systemctl >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		systemctl disable --quiet $BT_UNITS $WIFI_UNITS || true
	fi
	;;
esac

exit 0
