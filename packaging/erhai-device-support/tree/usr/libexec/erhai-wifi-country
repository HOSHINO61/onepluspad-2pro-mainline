#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Pass the Wi-Fi regulatory country derived from the system time zone.
#
# The WCN7860 starts in the world domain (00). It is lawful everywhere but
# keeps 5 GHz passive: the tablet joins 5 GHz networks, yet cannot start a
# hotspot there. The time zone chosen during first-run setup names the
# country the tablet is used in, and tzdata's zone.tab maps every zone to one
# country. A zone without an entry (UTC, Etc/*) uses the world domain.
set -u
localtime=${ERHAI_LOCALTIME:-/etc/localtime}
zone_tab=${ERHAI_ZONE_TAB:-/usr/share/zoneinfo/zone.tab}

target=$(readlink -f "$localtime" 2>/dev/null) || target=
zone=${target#*/zoneinfo/}
[ "$zone" != "$target" ] || zone=
country=
if [ -n "$zone" ] && [ -r "$zone_tab" ]; then
	country=$(awk -v zone="$zone" '$1 !~ /^#/ && $3 == zone { print $1; exit }' "$zone_tab")
fi
case $country in
[A-Z][A-Z]) ;;
*) country=00 ;;
esac
# cfg80211 looks for regulatory.db before the root file system is mounted and
# does not look again. Without the database it never completes a country
# hint, and every later hint waits behind that one, so only the first country
# set after boot would reach the radio. Load the database first.
iw reg reload 2>/dev/null || true
iw reg set "$country"
if [ "$country" = 00 ]; then
	echo "erhai-wifi-country: no country for time zone '${zone:-unset}'; using the world domain"
else
	echo "erhai-wifi-country: regulatory country $country from time zone $zone"
fi
