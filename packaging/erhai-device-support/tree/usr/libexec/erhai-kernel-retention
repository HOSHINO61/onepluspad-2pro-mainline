#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Protect the running and switcher-selected kernel payloads from apt autoremove."""
import argparse
import json
import os
from pathlib import Path
import re
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('release', help='Kernel being configured')
    parser.add_argument('--root', type=Path, default=Path('/'), help='Assembly root')
    args = parser.parse_args()
    root = args.root.resolve()
    releases = {args.release}
    for name in ('ubuntu', 'ubuntu.prev'):
        directory = root / 'var/lib/erhai/switch' / name
        path = directory / 'kernel.json'
        if path.is_file():
            release = json.loads(path.read_text()).get('kernel_release')
            if release:
                releases.add(release)
                continue
        # Pre-versioned installers recorded only the canonical payload path.
        # Do not mistake that installation record for the package metadata.
        legacy = directory / 'meta.json'
        if legacy.is_file():
            source = json.loads(legacy.read_text()).get('source', '')
            match = re.fullmatch(r'/usr/lib/erhai/boot/([a-z0-9.+-]{1,64})', source)
            if match:
                releases.add(match[1])
    if root == Path('/') and (root / 'run/systemd/system').is_dir():
        releases.add(os.uname().release)
    if any(not re.fullmatch(r'[a-z0-9.+-]{1,64}', release) for release in releases):
        raise SystemExit('invalid kernel release in retention inputs')
    # APT's built-in kernel name parser does not recognize the erhai prefix.
    # Use its standard exact-package protection, limited to selected kernels.
    patterns = ['^erhai-kernel-image-' + release.replace('.', '[.]').replace('+', '[+]') + '$'
                for release in sorted(releases)]
    text = '// Generated by erhai-kernel-retention from the selected kernel state.\n'
    text += 'APT::NeverAutoRemove {\n'
    text += ''.join('  ' + json.dumps(pattern) + ';\n' for pattern in patterns)
    text += '};\n'
    target = root / 'etc/apt/apt.conf.d/90-erhai-kernel-retention'
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as handle:
        handle.write(text)
        temporary = Path(handle.name)
    temporary.chmod(0o644)
    temporary.replace(target)


if __name__ == '__main__':
    main()
