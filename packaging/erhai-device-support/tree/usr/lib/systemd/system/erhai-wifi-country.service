[Unit]
Description=Set the Wi-Fi regulatory country to CN

[Service]
Type=oneshot
# The WCN7860 starts in the world domain (00), which keeps 5 GHz passive: the
# tablet joins 5 GHz networks but cannot start a hotspot there. This is a
# China-market model, and stock Android uses CN (ro.boot.wificountrycode=CN).
ExecStart=/usr/sbin/iw reg set CN
