# Tablet power button: lock and blank through GNOME, never suspend or power off.
[org.gnome.settings-daemon.plugins.power]
# The device power-key service handles the button. Keep the desktop action
# inert, including GNOME's unconditional poweroff fallback for VM chassis.
power-button-action='nothing'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
idle-dim=true

[org.gnome.desktop.session]
# Retaining MDSS power avoids frame-commit failures after blanking, but
# passing software checks still needs visual confirmation on the panel.
idle-delay=uint32 0

[org.gnome.desktop.screensaver]
lock-enabled=true

[org.gnome.desktop.a11y.applications]
screen-keyboard-enabled=true
