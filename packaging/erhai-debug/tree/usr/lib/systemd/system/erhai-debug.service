[Unit]
Description=Explicitly enabled USB NCM diagnostics
ConditionKernelCommandLine=erhai.debug=1
ConditionPathExists=/sys/class/net/usb0
After=local-fs.target
Wants=erhai-debug-http.service erhai-debug-shell.service erhai-debug-dhcp.service
Before=erhai-debug-http.service erhai-debug-shell.service erhai-debug-dhcp.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=erhai-debug
RuntimeDirectoryMode=0700
ExecStart=/usr/sbin/ip link set dev usb0 up
ExecStart=/usr/sbin/ip address replace 192.168.77.2/24 dev usb0
ExecStop=-/usr/sbin/ip address del 192.168.77.2/24 dev usb0

[Install]
WantedBy=multi-user.target
