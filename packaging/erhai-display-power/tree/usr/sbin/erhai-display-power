#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""Control both tablet backlights without disabling KMS or changing authentication."""
import os
from pathlib import Path
import signal
import socket
import struct
import subprocess

BACKLIGHTS = tuple(Path('/sys/class/backlight') / name / 'bl_power'
                  for name in ('ktz8868-master', 'ktz8868-slave'))


def active_uid():
    def query(args):
        return subprocess.check_output(['loginctl', *args], text=True,
                                       timeout=2).strip()
    sid = query(['show-seat', 'seat0', '-p', 'ActiveSession', '--value'])
    if not sid:
        raise RuntimeError('no active seat session')
    return int(query(['show-session', sid, '-p', 'User', '--value']))


class Backlights:
    def __init__(self, paths=BACKLIGHTS):
        self.paths = paths
        self.manual_blank = False
        self.owner = None

    def mode(self):
        values = [int(path.read_text().strip()) for path in self.paths]
        if any(value not in (0, 4) for value in values):
            raise RuntimeError('unexpected backlight power state')
        return 0 if all(value == 0 for value in values) else 3

    def set_mode(self, mode):
        value = '0\n' if mode == 0 else '4\n'
        # If either write fails, restore both LEDs instead of stranding the
        # session with a partial blank. GNOME owns the authentication boundary.
        try:
            for path in self.paths:
                path.write_text(value)
        except OSError:
            self.restore()
            raise
        return self.mode()

    def restore(self):
        for path in self.paths:
            try:
                path.write_text('0\n')
            except OSError:
                pass

    def request(self, request, uid, seat_uid):
        if uid not in (0, seat_uid):
            raise PermissionError('caller does not own the active seat')
        if seat_uid != self.owner:
            self.manual_blank = False
            self.owner = seat_uid
        if request == 'GET':
            return self.mode()
        fields = request.split()
        if len(fields) != 2 or fields[0] not in ('KEY', 'AUTO') or fields[1] not in ('0', '1', '2', '3'):
            raise ValueError('invalid request')
        origin, value = fields[0], int(fields[1])
        if origin == 'KEY':
            if uid != 0:
                raise PermissionError('only the system key handler sets manual intent')
            self.manual_blank = value != 0
        elif self.manual_blank and value == 0:
            # Completing a lock animation must not undo the explicit blank.
            return self.mode()
        result = self.set_mode(value)
        print(f'backlight power: {origin} uid={uid} mode={result}', flush=True)
        return result


def main():
    if os.environ.get('LISTEN_PID') != str(os.getpid()) or os.environ.get('LISTEN_FDS') != '1':
        raise RuntimeError('start through erhai-display-power.socket')
    lights = Backlights()
    lights.mode()  # Refuse startup if the board's two devices are missing.
    listener = socket.socket(fileno=3)
    def stop(_signal, _frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    try:
        while True:
            connection, _ = listener.accept()
            with connection:
                connection.settimeout(1)
                try:
                    _, uid, _ = struct.unpack('3i', connection.getsockopt(
                        socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))
                    data = b''
                    while b'\n' not in data and len(data) < 32:
                        chunk = connection.recv(32 - len(data))
                        if not chunk:
                            break
                        data += chunk
                    if not data.endswith(b'\n') or data.count(b'\n') != 1:
                        raise ValueError('invalid frame')
                    result = lights.request(data.decode('ascii').strip(), uid, active_uid())
                    connection.sendall(f'OK {result}\n'.encode('ascii'))
                except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                    print(f'backlight power: rejected request: {error}', flush=True)
                    try:
                        connection.sendall(b'ERR request failed\n')
                    except OSError:
                        pass
    finally:
        lights.restore()
        listener.close()


if __name__ == '__main__':
    main()
