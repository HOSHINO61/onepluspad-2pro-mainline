#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e
case "$1" in
remove) deb-systemd-helper mask erhai-display-power.socket >/dev/null || true ;;
purge)
    deb-systemd-helper purge erhai-display-power.socket >/dev/null || true
    deb-systemd-helper unmask erhai-display-power.socket >/dev/null || true
    ;;
esac
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
