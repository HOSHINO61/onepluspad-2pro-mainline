# Legacy TDM endpoint, following the upstream AudioReach I2S module layout.
include(`util/util.m4') dnl

`SectionVendorTokens."audioreach_tdm_tokens" {'
`        AR_TKN_U32_MODULE_ID "200"'
`        AR_TKN_U32_MODULE_INSTANCE_ID "201"'
`        AR_TKN_U32_MODULE_MAX_IP_PORTS "202"'
`        AR_TKN_U32_MODULE_MAX_OP_PORTS "203"'
`        AR_TKN_U32_MODULE_SRC_OP_PORT_ID "206"'
`        AR_TKN_U32_MODULE_DST_IN_PORT_ID "207"'
`        AR_TKN_U32_MODULE_SRC_INSTANCE_ID "208"'
`        AR_TKN_U32_MODULE_DST_INSTANCE_ID "209"'
`        AR_TKN_U32_MODULE_HW_IF_IDX "250"'
`        AR_TKN_U32_MODULE_HW_IF_TYPE "251"'
`        AR_TKN_U32_MODULE_FMT_DATA "253"'
`        AR_TKN_U16_MODULE_SYNC_SRC "262"'
`        AR_TKN_U16_MODULE_CTRL_DATA_OUT_ENABLE "263"'
`        AR_TKN_U32_MODULE_SLOT_MASK "264"'
`        AR_TKN_U16_MODULE_NSLOTS_PER_FRAME "265"'
`        AR_TKN_U16_MODULE_SLOT_WIDTH "266"'
`        AR_TKN_U16_MODULE_SYNC_MODE "267"'
`        AR_TKN_U16_MODULE_CTRL_INVERT_SYNC_PULSE "268"'
`        AR_TKN_U16_MODULE_CTRL_SYNC_DATA_DELAY "269"'
`        AR_TKN_U32_MODULE_ACTIVE_LANE_MASK "272"'
`}'

dnl AR_MODULE_TDM_RX(index, sg, container, iid, hw-type, hw-index, format,
dnl                  slot-mask, slots, width, lane-mask, sync-source, data-oe,
dnl                  sync-mode, invert-sync, data-delay, stream-name)
define(`AR_MODULE_TDM_RX',
`SectionVendorTuples."NAME_PREFIX.tdm_rx$1_tuples" {'
`        tokens "audioreach_tdm_tokens"'
`        tuples."word.u32_data" {'
`                AR_TKN_U32_MODULE_ID "0x0700100e"'
`                AR_TKN_U32_MODULE_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_MAX_IP_PORTS "1"'
`                AR_TKN_U32_MODULE_MAX_OP_PORTS "0"'
`                AR_TKN_U32_MODULE_SRC_OP_PORT_ID "1"'
`                AR_TKN_U32_MODULE_DST_IN_PORT_ID "0"'
`                AR_TKN_U32_MODULE_SRC_INSTANCE_ID STR($4)'
`                AR_TKN_U32_MODULE_DST_INSTANCE_ID "0"'
`                AR_TKN_U32_MODULE_HW_IF_TYPE STR($5)'
`                AR_TKN_U32_MODULE_HW_IF_IDX STR($6)'
`                AR_TKN_U32_MODULE_FMT_DATA STR($7)'
`                AR_TKN_U32_MODULE_SLOT_MASK STR($8)'
`                AR_TKN_U16_MODULE_NSLOTS_PER_FRAME STR($9)'
`                AR_TKN_U16_MODULE_SLOT_WIDTH STR($10)'
`                AR_TKN_U32_MODULE_ACTIVE_LANE_MASK STR($11)'
`                AR_TKN_U16_MODULE_SYNC_SRC STR($12)'
`                AR_TKN_U16_MODULE_CTRL_DATA_OUT_ENABLE STR($13)'
`                AR_TKN_U16_MODULE_SYNC_MODE STR($14)'
`                AR_TKN_U16_MODULE_CTRL_INVERT_SYNC_PULSE STR($15)'
`                AR_TKN_U16_MODULE_CTRL_SYNC_DATA_DELAY STR($16)'
`        }'
`}'
`SectionData."NAME_PREFIX.tdm_rx$1_data" {'
`        tuples "NAME_PREFIX.tdm_rx$1_tuples"'
`}'
`SectionWidget."NAME_PREFIX.tdm_rx$1" {'
`        index STR($1)'
`        type "aif_in"'
`        no_pm "true"'
`        stream_name "$17 Playback"'
`        subseq "10"'
`        data ['
`                "NAME_PREFIX.sub_graph$2_data"'
`                "NAME_PREFIX.container$3_data"'
`                "NAME_PREFIX.tdm_rx$1_data"'
`        ]'
`}') dnl
